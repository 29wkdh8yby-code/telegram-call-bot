# =============================================
# Telegram SMTP-to-SMS Bot — Environment File
# =============================================
# Copy this file to .env and fill in all values.

# Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
# Comma-separated list of admin Telegram user IDs (no spaces)
ADMIN_TELEGRAM_IDS=123456789

# Database (PostgreSQL)
# Format: ******HOST:PORT/DBNAME
DATABASE_URL=******localhost:5432/smsbot

# Redis
REDIS_URL=redis://localhost:6379/0

# Encryption key (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=your-32-byte-base64-fernet-key-here

# Timezone (used for daily usage reset)
APP_TIMEZONE=America/Detroit

# Rate limits
DAILY_MESSAGE_LIMIT=250
HOURLY_MESSAGE_LIMIT=50
MINUTE_MESSAGE_LIMIT=5

# Logging
LOG_LEVEL=INFO

# Web admin / health check
WEB_ADMIN_HOST=0.0.0.0
WEB_ADMIN_PORT=8080
WEB_ADMIN_SECRET=change-me-in-production

# PostgreSQL password (used by docker-compose)
POSTGRES_PASSWORD=changeme
