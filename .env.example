# ── Required ─────────────────────────────────────────────────────────────────
# Get your token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# ── Backend connection ────────────────────────────────────────────────────────
# Local / VPS:  http://127.0.0.1:5000/api
# Docker Compose: set automatically by docker-compose.yml (http://backend:5000/api)
# Railway:      set to your Railway backend service URL, e.g. https://your-backend.up.railway.app/api
BACKEND_API_BASE_URL=http://127.0.0.1:5000/api

# ── Database ──────────────────────────────────────────────────────────────────
# Local / VPS:       sqlite:///telegram_call_bot.db
# Docker Compose:    set automatically by docker-compose.yml (shared volume)
# Railway / managed: ******host:5432/dbname
DATABASE_URL=sqlite:///telegram_call_bot.db

# ── Tuning ────────────────────────────────────────────────────────────────────
REQUEST_TIMEOUT=15
STATUS_POLL_INTERVAL=5

# ── Backend defaults ──────────────────────────────────────────────────────────
DEFAULT_USER_CREDITS=10.0
AVAILABLE_NUMBERS=+12025550111,+12025550112,+12025550113
TRUNK_PROVIDER_NAME=example-trunk-provider
BACKEND_HOST=127.0.0.1
BACKEND_PORT=5000

# ── Logging ───────────────────────────────────────────────────────────────────
# Use WARNING or ERROR in production
LOG_LEVEL=INFO
